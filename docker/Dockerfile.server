FROM python:3.11-slim

WORKDIR /app

# Salin daftar dependensi dan instal pustaka gRPC + Pillow
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Salin kode sumber proyek
COPY protos/ ./protos/
COPY server/ ./server/

# Kompilasi ulang stub .proto di dalam container
RUN python -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. protos/image_service.proto

EXPOSE 50051

CMD ["python", "-m", "server.server", "--host", "0.0.0.0", "--port", "50051", "--rpc-workers", "20", "--img-workers", "4"]
